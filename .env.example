# =============================================================
# ComicPedia - Local Development Environment Variables
# Copy to .env.local:  cp .env.example .env.local
# =============================================================

# --- Text LLM Provider (Required) ---
TEXT_PROVIDER_TYPE=openai-compatible
TEXT_API_URL=https://api.openai.com/v1/chat/completions
TEXT_API_KEY=sk-your-key-here
TEXT_MODEL=gpt-4o

# --- Image Generation Provider (Optional) ---
# Types: openai-images | chat-image | custom-api | prompt-only
IMAGE_PROVIDER_TYPE=chat-image
IMAGE_API_URL=https://api.openai.com/v1/chat/completions
IMAGE_API_KEY=sk-your-key-here
IMAGE_MODEL=gpt-4o
IMAGE_SIZE=1024x1024

# --- Concurrency ---
MAX_IMAGE_WORKERS=3

# --- Showcase mode (redirect home to /gallery) ---
# SHOWCASE_MODE=true
