    "clean": "rm -rf data/ && echo 'data/ removed, restart to get a fresh database'"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.23",
    "better-sqlite3": "^11.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.40",
    "lucide-react": "^1.7.0",
    "next": "^15.5.14",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
