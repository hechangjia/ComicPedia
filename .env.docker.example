# =============================================================
# Comicpedia - Docker Environment Variables Template
# Copy to .env and fill in your values:  cp .env.docker.example .env
# =============================================================

# --- Text LLM Provider (Required) ---
# Type: openai-compatible | anthropic
TEXT_PROVIDER_TYPE=openai-compatible
TEXT_API_URL=https://api.openai.com/v1/chat/completions
TEXT_API_KEY=sk-your-key-here
TEXT_MODEL=gpt-4o

# --- Image Generation Provider (Required) ---
# Type: openai-images | chat-image | custom-api | prompt-only
#
# openai-images  — OpenAI DALL-E endpoint (/v1/images/generations)
# chat-image     — Models that return images via /chat/completions (Gemini, GPT-4o)
# custom-api     — Custom image generation API
# prompt-only    — Skip image generation, only produce text prompts
IMAGE_PROVIDER_TYPE=chat-image
IMAGE_API_URL=https://api.openai.com/v1/chat/completions
IMAGE_API_KEY=sk-your-key-here
IMAGE_MODEL=gpt-4o
IMAGE_SIZE=1024x1024

# --- Concurrency ---
# Max parallel image generation workers (default: 3)
MAX_IMAGE_WORKERS=3

# --- Server ---
# Port the app listens on inside the container (default: 61323)
# PORT=61323

# --- HTTPS (可选，启用 Nginx 反向代理时配置) ---
# 你的域名（用于 Nginx 和 Let's Encrypt 证书）
# DOMAIN=comic.example.com
